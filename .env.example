# ─────────────────────────────────────────────────────────────────────────────
# SmartQueue — environment variables
# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USERNAME=smartqueue
DB_PASSWORD=change-me-in-production

# ── Application settings ──────────────────────────────────────────────────────
# Set to "true" only for a full local reset (wipes queue state)
SMARTQUEUE_RESET_ON_STARTUP=false
ENABLE_AUTO_REBALANCE=true

# ── Clinic scheduling ─────────────────────────────────────────────────────────
CLINIC_OPEN_HOUR=8
CLINIC_CLOSE_HOUR=20
CLINIC_BREAK_START_HOUR=13
CLINIC_BREAK_END_HOUR=14

# ── AI Executor (tune based on available CPU cores) ───────────────────────────
AI_EXECUTOR_CORE=4
AI_EXECUTOR_MAX=16
AI_EXECUTOR_QUEUE=50

# ── Starvation prevention ─────────────────────────────────────────────────────
# Lower values = more aggressive boosts; 500_000 is a safe default
STARVATION_SCORE_REDUCTION=500000

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Set in .env, NOT here — never commit real bot tokens
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_BOT_WEBHOOK_BASE_URL=https://your-public-ngrok-url
